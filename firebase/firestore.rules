rules_version = '2';

// Aturan keamanan Firestore untuk project kopma-um (web kasir + Kopma Hub).
// Disusun dari semua operasi baca/tulis yang ada di web kasir (KasirKopmaUM2026/index.html):
//  - role "kasir": jualan (kurangi stok produk + buat transaksi)
//  - role "admin": semua menu kasir (produk, barang masuk, riwayat, laporan, pengeluaran, modal harian)
//  - Kopma Hub: membaca data kasir; ketua & sekretaris mengelola anggota dan peran; anggota mendaftar dengan kode;
//    setiap perubahan dari Kopma Hub wajib meninggalkan catatan di koleksi jejak
// Semua yang tidak disebut di bawah otomatis DITOLAK.

service cloud.firestore {
  match /databases/{database}/documents {

    function masuk() { return request.auth != null; }
    function akun() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function terdaftar() { return masuk() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function admin() { return terdaftar() && akun().role == 'admin'; }
    function petugas() { return terdaftar() && akun().role in ['admin', 'kasir']; }
    // peran di Kopma Hub disimpan di field "hub" (daftar) pada dokumen users, contoh: ["ketua"]
    function punyaHub(daftar) { return terdaftar() && akun().get('hub', []).hasAny(daftar); }
    function niaSaya() { return terdaftar() ? akun().get('nia', '') : ''; }
    function berubahHanya(kolom) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(kolom); }
    // NIA yang diklaim akun ini dalam penulisan yang sama (batch) harus milik akun ini
    function klaimMilikku(nia) { return getAfter(/databases/$(database)/documents/klaim_nia/$(nia)).data.uid == request.auth.uid; }
    function bisaKlaim(nia) { return nia is string && nia.size() >= 3 && exists(/databases/$(database)/documents/anggota/$(nia)) && klaimMilikku(nia); }
    // ---------- Jejak wajib ----------
    // Setiap perubahan dari Kopma Hub ke anggota, users (peran/NIA/pendaftaran), dan pengaturan/poin harus menyimpan
    // field jejakId yang menunjuk catatan BARU di koleksi jejak, ditulis dalam batch yang sama oleh akun yang sama
    // dan untuk dokumen yang sama. Tanpa catatan itu, perubahannya ditolak.
    function jejakDoc(id) { return /databases/$(database)/documents/jejak/$(id); }
    function jejakBaru(target) {
      let id = request.resource.data.get('jejakId', '');
      return id is string && id.size() > 0 && !exists(jejakDoc(id))
        && getAfter(jejakDoc(id)).data.uid == request.auth.uid
        && getAfter(jejakDoc(id)).data.target == target;
    }
    // kolom yang berubah harus sudah disebut di catatan jejak (kecuali kolom pencatat)
    function kolomTercatat() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(getAfter(jejakDoc(request.resource.data.jejakId)).data.kolom.concat(['jejakId', 'diubah', 'diubahOleh']));
    }
    function perananHub() { return ['ketua', 'sekretaris', 'bendahara', 'bidang_usaha', 'petugas_jaga', 'pengurus']; }

    // ---------- Akun ----------
    // Pendaftaran mandiri (lewat Kopma Hub) hanya sah kalau: kode pendaftaran benar (dicek di server,
    // kodenya disimpan di pengaturan/pendaftaran yang tidak bisa dibaca siapa pun), NIA sudah ada di
    // data anggota, dan NIA itu belum diklaim akun lain. Akun baru selalu ber-role "anggota" tanpa peran hub.
    match /users/{uid} {
      allow read: if masuk() && (request.auth.uid == uid || admin() || punyaHub(['ketua', 'sekretaris', 'bendahara', 'bidang_usaha']));
      allow create: if admin()
        || (masuk() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['username', 'role', 'nia', 'dibuat', 'jejakId'])
            && request.resource.data.role == 'anggota'
            && request.auth.token.email == request.resource.data.username + '@kopma.um'
            && existsAfter(/databases/$(database)/documents/bukti_daftar/$(uid))
            && bisaKlaim(request.resource.data.nia)
            && jejakBaru('users/' + uid));
      allow update: if admin()
        // ketua/sekretaris mengatur peran Kopma Hub orang lain (bukan dirinya sendiri, bukan role kasir)
        || (punyaHub(['ketua', 'sekretaris']) && request.auth.uid != uid
            && berubahHanya(['hub', 'jejakId'])
            && request.resource.data.hub is list && request.resource.data.hub.hasOnly(perananHub())
            && jejakBaru('users/' + uid) && kolomTercatat())
        // akun lama (tanpa NIA) menghubungkan NIA-nya sendiri
        || (request.auth.uid == uid && resource.data.get('nia', '') == ''
            && berubahHanya(['nia', 'jejakId']) && bisaKlaim(request.resource.data.nia)
            && jejakBaru('users/' + uid) && kolomTercatat());
      allow delete: if admin();
    }

    // Satu NIA hanya untuk satu akun. Dibuat bersamaan dengan pendaftaran / penghubungan NIA.
    match /klaim_nia/{nia} {
      allow read: if admin() || punyaHub(['ketua', 'sekretaris']);
      allow create: if masuk()
        && request.resource.data.keys().hasOnly(['uid', 'dibuat'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nia == nia;
      allow update: if false;
      allow delete: if admin();         // admin bisa melepas klaim yang salah
    }

    // Bukti kode pendaftaran benar. Kodenya dicocokkan di server; tidak ada yang bisa membaca dokumen ini.
    match /bukti_daftar/{uid} {
      allow create: if masuk() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kode'])
        && request.resource.data.kode is string && request.resource.data.kode.size() >= 6   // kode kosong/pendek selalu ditolak
        && request.resource.data.kode == get(/databases/$(database)/documents/pengaturan/pendaftaran).data.kode;
      allow read, update, delete: if false;
    }

    // Pengaturan rahasia (kode pendaftaran). Hanya diubah lewat Firebase Console.
    match /pengaturan/{id} {
      allow read, write: if false;
    }

    // Rumus poin bersama (1 poin setiap rpPerPoin rupiah). Dokumen ini saja yang boleh dibaca semua akun
    // terdaftar; pengaturan/pendaftaran tetap tertutup karena aturan di atas tidak memberi izin apa pun.
    match /pengaturan/poin {
      allow read: if terdaftar();
      allow create, update: if (admin() || punyaHub(['ketua', 'bendahara']))
        && request.resource.data.keys().hasOnly(['rpPerPoin', 'diubah', 'diubahOleh', 'jejakId'])
        && jejakBaru('pengaturan/poin')
        && request.resource.data.rpPerPoin is int
        && request.resource.data.rpPerPoin >= 100 && request.resource.data.rpPerPoin <= 1000000
        && request.resource.data.diubah == request.time
        && request.resource.data.diubahOleh == akun().get('username', '');
      allow delete: if false;
    }

    // ---------- Data anggota (Kopma Hub) ----------
    // ID dokumen = NIA, jadi satu NIA tidak bisa terdaftar dua kali. Data tidak pernah dihapus.
    match /anggota/{nia} {
      allow read: if punyaHub(['ketua', 'sekretaris', 'bendahara']) || admin() || (niaSaya() != '' && niaSaya() == nia);
      // pemilik NIA memperbarui datanya sendiri (bukan status, bidang, atau NIA)
      allow update: if niaSaya() != '' && niaSaya() == nia
        && berubahHanya(['nama', 'fakultas', 'prodi', 'angkatan', 'wa', 'diubah', 'diubahOleh', 'jejakId'])
        && request.resource.data.nama is string && request.resource.data.nama.size() >= 2
        && jejakBaru('anggota/' + nia) && kolomTercatat();
      allow create, update: if punyaHub(['ketua', 'sekretaris'])
        && request.resource.data.nia == nia
        && request.resource.data.keys().hasOnly(['nia', 'nama', 'fakultas', 'prodi', 'angkatan', 'wa', 'status', 'bidang', 'aktif', 'dibuat', 'dibuatOleh', 'diubah', 'diubahOleh', 'jejakId'])
        && request.resource.data.nama is string && request.resource.data.nama.size() >= 2
        && request.resource.data.status in ['anggota', 'pengurus']
        && jejakBaru('anggota/' + nia) && (resource == null || kolomTercatat());
      allow delete: if false;
    }

    // ---------- Jejak perubahan (Kopma Hub) ----------
    // Catatan hanya bisa DITAMBAH, tidak bisa diubah atau dihapus siapa pun dari aplikasi.
    // Catatan harus menempel pada perubahan sungguhan: dokumen targetnya, setelah batch selesai, menunjuk catatan ini.
    match /jejak/{id} {
      allow read: if punyaHub(['ketua', 'sekretaris', 'bendahara']) || admin();
      allow create: if masuk()
        && request.resource.data.keys().hasOnly(['modul', 'aksi', 'target', 'kolom', 'oleh', 'uid', 'waktu'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.oleh == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.waktu == request.time
        && request.resource.data.modul in ['anggota', 'akun', 'poin', 'gaji', 'jadwal']
        && request.resource.data.aksi is string && request.resource.data.aksi.size() >= 3 && request.resource.data.aksi.size() <= 300
        && request.resource.data.kolom is list && request.resource.data.kolom.size() <= 20
        && request.resource.data.target is string
        && request.resource.data.target.matches('^(anggota|users|jadwal_jaga|penarikan_gaji)/[^/]+$|^pengaturan/poin$')
        && getAfter(path('/databases/' + database + '/documents/' + request.resource.data.target)).data.get('jejakId', '') == id;
      allow update, delete: if false;
    }

    // ---------- Jadwal jaga (Kopma Hub) ----------
    // Satu dokumen per tanggal (ID = YYYY-MM-DD) berisi nama pengguna petugas. Semua akun terdaftar bisa melihat;
    // bidang usaha, ketua, dan admin yang mengatur. Tidak pernah dihapus (dikosongkan saja).
    match /jadwal_jaga/{tgl} {
      allow read: if terdaftar();
      allow create, update: if (admin() || punyaHub(['ketua', 'bidang_usaha']))
        && tgl.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['tanggal', 'petugas', 'catatan', 'diubah', 'diubahOleh', 'jejakId'])
        && request.resource.data.tanggal == tgl
        && request.resource.data.petugas is list && request.resource.data.petugas.size() <= 10
        && request.resource.data.get('catatan', '') is string && request.resource.data.get('catatan', '').size() <= 200
        && jejakBaru('jadwal_jaga/' + tgl) && (resource == null || kolomTercatat());
      allow delete: if false;
    }

    // ---------- Penarikan gaji jaga (Kopma Hub) ----------
    // Gaji = 1% penjualan akun kasir sendiri per hari, dihitung dari transaksi (bukan disimpan).
    // Petugas mengajukan penarikan (minimal Rp10.000); ketua/bendahara/admin menandai dibayar atau ditolak,
    // tapi tidak bisa memproses penarikannya sendiri. Kecukupan saldo dicek aplikasi dan oleh yang membayar.
    match /penarikan_gaji/{id} {
      allow read: if terdaftar() && (resource.data.uid == request.auth.uid || admin() || punyaHub(['ketua', 'bendahara']));
      allow create: if terdaftar()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'nominal', 'status', 'diajukan', 'jejakId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == akun().get('username', '')
        && request.resource.data.nominal is int
        && request.resource.data.nominal >= 10000 && request.resource.data.nominal <= 5000000
        && request.resource.data.status == 'diajukan'
        && request.resource.data.diajukan == request.time
        && jejakBaru('penarikan_gaji/' + id);
      allow update: if resource.data.status == 'diajukan'
        && request.resource.data.diproses == request.time
        && request.resource.data.diprosesOleh == akun().get('username', '')
        && (
          ((admin() || punyaHub(['ketua', 'bendahara'])) && resource.data.uid != request.auth.uid
            && request.resource.data.status in ['dibayar', 'ditolak']
            && berubahHanya(['status', 'diproses', 'diprosesOleh', 'alasan', 'jejakId'])
            && request.resource.data.get('alasan', '') is string && request.resource.data.get('alasan', '').size() <= 200)
          || (resource.data.uid == request.auth.uid
            && request.resource.data.status == 'dibatalkan'
            && berubahHanya(['status', 'diproses', 'diprosesOleh', 'jejakId']))
        )
        && jejakBaru('penarikan_gaji/' + id) && kolomTercatat();
      allow delete: if false;
    }

    // ---------- Produk ----------
    match /products/{id} {
      allow read: if petugas();
      allow create, delete: if admin();
      // admin bebas mengubah; kasir hanya boleh mengubah angka stok (saat jualan)
      allow update: if admin()
        || (petugas()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stok'])
            && request.resource.data.stok is number
            && request.resource.data.stok >= 0);
    }

    // ---------- Transaksi ----------
    match /transactions/{id} {
      // anggota hanya bisa membaca transaksi dengan NIA miliknya sendiri (untuk poin);
      // pengurus inti & bidang usaha membaca semua (laporan jaga); setiap akun membaca transaksi yang dia layani (gaji)
      allow read: if petugas()
        || (niaSaya() != '' && resource.data.get('niaAnggota', '') == niaSaya())
        || punyaHub(['ketua', 'sekretaris', 'bendahara', 'bidang_usaha'])
        || (terdaftar() && resource.data.get('kasir', '') == akun().get('username', ''));
      allow create: if petugas()
        && request.resource.data.total is number
        && request.resource.data.item is list;
      allow update: if false;          // transaksi tidak boleh diedit
      allow delete: if admin();        // hapus transaksi (menu Riwayat) hanya admin
    }

    // ---------- Pengeluaran (termasuk catatan stok masuk) ----------
    match /pengeluaran/{id} {
      allow read: if petugas();
      allow create, delete: if admin();
      allow update: if false;
    }

    // ---------- Modal harian ----------
    match /modal_harian/{tanggal} {
      allow read: if petugas();
      allow write: if admin();
    }
  }
}
